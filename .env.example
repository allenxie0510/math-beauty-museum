# Vercel + Supabase deployment. Never expose the service-role key in a
# NEXT_PUBLIC_ variable or commit a real key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me

# Math observer · Qwen decision + Qwen3-TTS. Keep every value below server-side.
DASHSCOPE_API_KEY=sk_replace_me
QWEN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_OBSERVER_MODEL=qwen-plus
# Voice questions use Qwen ASR. The default base URL above remains compatible;
# for the recommended workspace endpoint, use:
# QWEN_ASR_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_ASR_MODEL=qwen3-asr-flash
# Use cosyvoice-v3-flash for built-in CosyVoice voices such as longjielidou_v3,
# qwen3-tts-vd-2026-01-26 for a designed voice, or qwen3-tts-vc-2026-01-22
# for an authorized cloned voice. The model and voice must belong together.
QWEN_TTS_MODEL=qwen3-tts-vd-2026-01-26
QWEN_TTS_VOICE=replace_with_voice_id
QWEN_VOICE_PROMPT=清亮温暖的青少年男声，普通话标准，自然口语，有好奇心和耐心，不要播音腔，不要刻意卖萌。
